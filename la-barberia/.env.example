# Copie para .env.local e preencha. NUNCA faça commit do ficheiro .env.local.

# Ligação ao Postgres (Supabase, Neon ou outro). Em Supabase use a "connection string" do projeto.
# Exemplo local: postgres://postgres@localhost:5432/labarberia
DATABASE_URL=

# Segredo longo e aleatório (mínimo 32 caracteres). Gere com: openssl rand -base64 48
# Usado para derivar os links privados das marcações e para anonimizar IPs nos limites de pedidos.
# ATENÇÃO: se o alterar, os links privados já enviados deixam de funcionar.
APP_SECRET=

# URL público do site, sem barra final. Ex.: https://la-barberia.exemplo.app
PUBLIC_BASE_URL=http://localhost:3000

# Opcional: protege /api/cron/maintenance (limpeza de dados antigos e "manter a base de dados ativa").
# Gere com: openssl rand -base64 32
CRON_SECRET=

# Opcional: email de confirmação (Resend, API HTTP). Se vazio, não são enviados emails.
# Atenção: para enviar a clientes é preciso verificar um domínio no fornecedor.
RESEND_API_KEY=
EMAIL_FROM=

# Opcional: ligações máximas por instância (predefinição 5; em alojamento serverless use 1-3).
DB_POOL_MAX=

# Apenas para testes automáticos (base de dados descartável; as tabelas são apagadas!).
TEST_DATABASE_URL=
