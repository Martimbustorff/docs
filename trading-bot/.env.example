# Trading bot environment. Copy this file, then lock it down:
#
#   cp .env.example .env
#   chmod 600 .env
#
# WARNINGS
# - Never commit .env. It is already in .gitignore and .dockerignore.
# - Never paste a key into any chat: not an AI assistant, not Telegram, not Slack, not email.
#   Type or paste keys straight into this file on the machine that runs the bot.
# - Give exchange keys trade permission only, with withdrawals switched OFF. Alpaca Trading
#   API keys can't withdraw money. On any other exchange, disable withdrawals and add an IP
#   allowlist before you create the key.
# - Paper is the default. Leave TRADING_MODE, ALPACA_PAPER and LIVE_TRADING_ACK alone until
#   `python -m bot final-check` has passed. See README.md, "Paper first, live later".
#
# Format: KEY=value, one per line, comments on their own lines only. An empty value means
# "not set" and the bot uses its default. If a value contains $, # or spaces, wrap it in
# single quotes, e.g. KEY='value with spaces'.

# --- Alpaca (broker) ---------------------------------------------------------------------
# Generate paper keys in the Alpaca dashboard (https://app.alpaca.markets): switch to your
# paper account, then use the API keys panel on its home page. Paper key IDs start with PK.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper account. Only a passed final check justifies false.
ALPACA_PAPER=true

# --- Jev (TypeSafe AI System One) ------------------------------------------------------------
# Scores entry setups and can only veto them. With no key, `run --dry-run` uses a fake client;
# a real run blocks every entry (fail-closed). Check the key with `python -m bot jev-ping`.
TYPESAFE_API_KEY=

# --- Telegram (alerts, approvals, /kill) -----------------------------------------------------
# Create the bot with @BotFather and find your chat id: deploy/TELEGRAM.md.
# Without both values the bot only logs alerts to the console, and nobody can approve an
# entry above the approval threshold, so those entries expire.
TELEGRAM_BOT_TOKEN=
# Only this chat can command the bot. Every other chat is ignored and logged.
TELEGRAM_CHAT_ID=

# --- Dashboard (read-only web UI) ------------------------------------------------------------
DASHBOARD_USER=admin
# Required when the dashboard listens on anything but 127.0.0.1, which includes Docker.
# Generate one with: openssl rand -hex 24
DASHBOARD_PASSWORD=
# Local runs bind to loopback. docker-compose.yml overrides this to 0.0.0.0 inside the
# container and publishes it on the host's 127.0.0.1:8080 only.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# --- Trading mode and safety -----------------------------------------------------------------
# paper | live. Live also needs ALPACA_PAPER=false, LIVE_TRADING_ACK and a passed final check
# younger than 7 days (var/live_gate.json).
TRADING_MODE=paper
# Leave empty. Going live means typing the exact LIVE_ACK_PHRASE from bot/config.py here,
# after you have read the WHAT COULD BLOW UP THIS ACCOUNT? section of strategy.md.
LIVE_TRADING_ACK=
# 1 forces the kill switch on: no new entries, and bot positions are flattened.
KILL_SWITCH=0

# --- Storage -----------------------------------------------------------------------------
# Runtime state (SQLite, kill switch file, reports). Empty = var/ in the repo.
# docker-compose.yml always sets /app/var inside the containers.
BOT_DATA_DIR=

# --- Docker build (read by docker compose, ignored by the bot) -----------------------------
# The container runs as this uid/gid so it can write ./var and ./data on the host.
# Set them to the output of `id -u` and `id -g` for the user that runs docker compose.
APP_UID=1000
APP_GID=1000
