# Starts the trading bot's Docker Compose stack at boot and stops it cleanly at shutdown.
#
# Install (deploy/VPS.md, "Start the bot on boot"):
#   sudo cp deploy/trading-bot.service /etc/systemd/system/
#   sudo sed -i "s#/home/trader#$HOME#g; s#^User=trader#User=$USER#" /etc/systemd/system/trading-bot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trading-bot
#
# Docker's `restart: unless-stopped` restarts crashed containers. This unit also brings the
# stack back after a reboot even if you ran `docker compose down`. To keep the bot off across
# reboots, run: sudo systemctl disable --now trading-bot

[Unit]
Description=Paper-first trading bot (Docker Compose: bot + dashboard)
Documentation=file:///home/trader/trading-bot/deploy/VPS.md
Requires=docker.service
After=docker.service network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The user must be in the docker group. Compose reads docker-compose.yml and .env from here.
User=trader
Group=docker
WorkingDirectory=/home/trader/trading-bot
# Uses the image you built last; updates are a deliberate `docker compose build`.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
